{
  "name": "zrow-js",
  "main": "dist/ACSVTranspiler.js",
  "module": "dist/ACSVTranspiler.js",
  "types": "dist/ACSVTranspiler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ACSVTranspiler.d.ts",
      "import": "./dist/ACSVTranspiler.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:cli && tsc && vite build && node scripts/build-site.mjs",
    "preview": "vite preview",
    "build:cli": "tsc --project tsconfig.cli.json",
    "build:lib": "tsc --project tsconfig.lib.json",
    "test:acsv": "npm run build:lib && npm run build:cli && node scripts/acsv-test-runner.mjs",
    "test": "npm run build:lib && npm run build:cli && vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx wrangler@4.165.0 deploy",
    "dev:worker": "npm run build && npx wrangler@4.165.0 dev",
    "prepack": "npm run build:lib && npm run build:cli",
    "deploy:redirect": "npx wrangler@4.165.0 deploy --config wrangler.redirect.jsonc"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.16",
    "marked": "^15.0.12",
    "postcss": "^8.4.30",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^4.0.5",
    "solid-js": "^1.7.8"
  },
  "license": "MIT",
  "homepage": "https://zrow.majaku.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/made-by-chris/zrow.git"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "cli/*.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "zrow": "cli/ACSV.js"
  },
  "description": "Readable, deterministic recipes for CSV and typed JSON fixtures.",
  "keywords": [
    "zrow",
    "csv",
    "json",
    "fixtures",
    "test-data",
    "game-data"
  ]
}
