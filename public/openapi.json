{
  "openapi": "3.1.0",
  "info": {
    "title": "ZROW conversion API",
    "version": "0.6.0"
  },
  "servers": [
    {
      "url": "https://zrow.majaku.com"
    }
  ],
  "paths": {
    "/api/v1/convert": {
      "post": {
        "summary": "Compile ZROW into CSV or typed JSON",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "mode": {
                    "enum": [
                      "csv",
                      "zrow"
                    ],
                    "default": "zrow"
                  },
                  "format": {
                    "enum": [
                      "csv",
                      "json"
                    ],
                    "default": "csv"
                  },
                  "seed": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    ],
                    "description": "Random seed; use either this or a document seed declaration."
                  },
                  "referenceTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Fixed reference timestamp with seconds and Z or a UTC offset. Use either this or a document time declaration."
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "description": "Overrides for explicitly declared parameters; unknown names are rejected."
                  },
                  "table": {
                    "type": "string",
                    "description": "Named table to export. Required for CSV datasets; omit for JSON to export all tables."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversion result"
          },
          "400": {
            "description": "Invalid input"
          },
          "413": {
            "description": "Body too large"
          },
          "415": {
            "description": "Content type"
          },
          "422": {
            "description": "Compilation diagnostic"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  }
}
