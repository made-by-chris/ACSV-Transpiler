{
  "name": "zrow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/v1/*"],
  },
  "routes": [
    {
      "pattern": "zrow.majaku.com",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "limits": {
    "cpu_ms": 100,
  },
}
